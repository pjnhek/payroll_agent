DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require
EXTRACTION_MODEL=deepseek-v4-flash
EXTRACTION_BASE_URL=https://api.deepseek.com
EXTRACTION_API_KEY=sk-your-deepseek-key-here
DRAFT_MODEL=moonshot-v1-8k
DRAFT_BASE_URL=https://api.moonshot.ai/v1
DRAFT_API_KEY=sk-your-moonshot-key-here
TAX_YEAR=2026
ALLOW_LIVE_LLM=0

# ── Resend email provider ───────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here
WEBHOOK_SIGNING_SECRET=your_webhook_signing_secret_here
RESEND_FROM_ADDR=onboarding@resend.dev

# REPLY-TO TOPOLOGY: set to your inbound .resend.app address (the address wired to
# the Resend inbound webhook). Client replies are directed here, not to RESEND_FROM_ADDR.
# Leave empty to omit Reply-To from outbound sends.
RESEND_REPLY_TO=payroll@jiodnel.resend.app

# ── Durable job queue ────────────────────────────────────────────────
# See app/config.py for the derivations (LEASE_SECONDS' comment carries the
# STALE_THRESHOLD cross-reference; MAX_ATTEMPTS' comment carries the scoping
# caveat about when the attempts counter advances).
WORKER_COUNT=2
LEASE_SECONDS=900
MAX_ATTEMPTS=5
QUEUE_POLL_SECONDS=20

# DEMO OUTBOUND OVERRIDE (demo affordance, not a production feature).
# Resend's free tier with FROM=onboarding@resend.dev only delivers to the account
# owner's own address, so the seeded RFC 2606 .example contacts are undeliverable.
# When set, EVERY outbound client email (confirmation + clarification) is redirected
# to this address at snapshot-reservation time. Empty = off, and off is the
# production-safe default. See app/email/routing.py.
DEMO_OUTBOUND_TO=

# DEMO OPERATOR EMAIL: inbound leg of Path-2 demo routing (POST /demo/bind
# writes this address into demo_sender_bindings). DEMO_OUTBOUND_TO above is
# the outbound leg. Unset (empty) is the production-safe default: /demo/bind
# refuses rather than binding an empty operator address. See app/config.py.
DEMO_OPERATOR_EMAIL=

# Optional, local only: with DEMO_OPERATOR_EMAIL, lets scripts/demo_reset.py
# re-arm the demo binding automatically instead of printing a warning and
# skipping. One of "Coastal Cleaning Co." / "Metro Deli Group" /
# "Summit Tech Solutions".
DEMO_BUSINESS_NAME=
